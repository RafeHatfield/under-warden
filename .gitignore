# Godot 4+ specific ignores
.godot/
/android/

# Headless iOS build output (tools/ios_build.sh)
/.ios-build/
/.ios-build-*/

# .NET build output
bin/
obj/

# macOS
.DS_Store

# Per-session git worktrees (see CLAUDE.md: one working copy per session)
/.claude/worktrees/

# Tier 0 review-build marker. Written transiently by tools/tier0_harness/build_review_app.sh and
# removed on exit; committing it would turn every subsequent build into a review build that boots
# the art corridor instead of the game. Only the .template is tracked.
/src/Presentation/assets/tier0_harness/REVIEW_BUILD.json

# Python bytecode. A committed .pyc is rewritten on every fresh checkout (source mtime changes),
# which dirties the tree and moves the frame-critic build id before any art has changed.
__pycache__/
*.pyc
